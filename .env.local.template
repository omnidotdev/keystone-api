# database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/keystone?schema=public"

# GraphQL
# https://escape.tech/graphql-armor/docs/plugins/cost-limit
GRAPHQL_MAX_COMPLEXITY_COST="400"

# allowed origins for CORS (comma-separated) (https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Origin)
CORS_ALLOWED_ORIGINS="https://localhost:3000"

# feature flags
FLAGS_CLIENT_KEY=

# Vortex (event streaming)
VORTEX_API_URL="https://localhost:5000"
VORTEX_API_KEY=""

# service-to-service auth
# INTERNAL_SERVICE_KEY=
# SERVICE_ORGANIZATION_ID=

# external provider URLs
# BILLING_BASE_URL=
# AUTHZ_API_URL=
# AUTHZ_ENABLED=true

# ---- Keystone ----

# Required: AI generation. The Anthropic SDK resolves credentials from
# ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile.
# ANTHROPIC_API_KEY=

# Optional: public base for served/published site URLs (defaults to the API origin)
# PUBLIC_BASE_URL=

# Optional: live (hosted) publish to Fractal. Without the full set below,
# /publish serves the sanitized site from this API (read-only preview) instead
# of deploying a per-site staticSite FractalService. Hosted publish needs ALL of:
#   KEYSTONE_HOSTED_PUBLISH_ENABLED=true, FRACTAL_API_URL, FRACTAL_API_TOKEN,
#   ARBOR_API_URL, ARBOR_GIT_BASE, ARBOR_SERVICE_TOKEN, ARBOR_SERVICE_OWNER.
# FRACTAL_API_URL=
# FRACTAL_API_TOKEN=
# ARBOR_API_URL="https://api.arbor.omni.dev/graphql"
# ARBOR_GIT_BASE="https://api.arbor.omni.dev/git"
# Keystone's own Arbor publisher service account. Site repos are created + pushed
# AS this account (its Omni id whitelisted in Arbor once), so end users never
# need their own Arbor access. ARBOR_SERVICE_OWNER is the account's Arbor username.
# ARBOR_SERVICE_TOKEN=
# ARBOR_SERVICE_OWNER="keystone"

# Optional ecosystem integration blocks. Each degrades gracefully when unset:
# buy/support fall back to a link-out; email capture reports "not configured"
# (never silently drops an address); repo showcase is always a link-out.
# HALO_API_URL=
# HALO_SERVICE_KEY=
# CRYSTAL_API_URL=
# HERALD_API_URL=
# HERALD_API_KEY=
# ARBOR_APP_URL="https://arbor.omni.dev"
